+#!/usr/bin/env python3
+"""노션에서 상태가 발행인데 posts.json에 없는 글을 한 번 반영한다.
+
+매일 동기화는 통합 STARGATE가 데이터베이스에 연결되기 전까지 실패한다.
+이 스크립트는 그 공백 동안 이미 승인된 본문을 허브에 올린다.
+"""
+
+from __future__ import annotations
+
+import html
+import json
+import re
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+SRC = Path(__file__).resolve().parent / "issued"
+OUT = ROOT / "posts" / "posts.json"
+KST = timezone(timedelta(hours=9))
+
+CATEGORY_META = {
+    "교육·입시": {"emoji": "🎓", "color": "#2E7D32"},
+    "AI·테크": {"emoji": "🤖", "color": "#1E5BC6"},
+    "창업·경영": {"emoji": "🏢", "color": "#E65100"},
+    "도시·연구": {"emoji": "🏙️", "color": "#6A1B9A"},
+    "출판·서평": {"emoji": "📚", "color": "#5D4037"},
+    "시사·정치": {"emoji": "🗳️", "color": "#B26A00"},
+    "공지": {"emoji": "📢", "color": "#C62828"},
+}
+
+
+def with_hub_utm(url: str) -> str:
+    if not url or "utm_" in url:
+        return url
+    host = url.split("/")[2] if "://" in url else ""
+    if host == "stargateedu.co.kr" or host.endswith(".stargateedu.co.kr"):
+        sep = "&" if "?" in url else "?"
+        return f"{url}{sep}utm_source=blog&utm_medium=post&utm_campaign=hub"
+    return url
+
+
+def inline(text: str) -> str:
+    text = text.replace("\\[", "\u0000").replace("\\]", "\u0001").replace("\\~", "~")
+    links: list[tuple[str, str]] = []
+
+    def stash(match: re.Match[str]) -> str:
+        links.append((match.group(1), match.group(2)))
+        return f"\u0002{len(links) - 1}\u0002"
+
+    text = re.sub(r"\[([^\]]+)\]\((https?://[^)\s]+)\)", stash, text)
+    pieces = re.split(r"(</?b>|</?i>|</?u>|</?s>)", text)
+    allowed = {"<b>", "</b>", "<i>", "</i>", "<u>", "</u>", "<s>", "</s>"}
+    out = []
+    for piece in pieces:
+        if piece in allowed:
+            out.append(piece)
+            continue
+        escaped = html.escape(piece).replace("\u0000", "[").replace("\u0001", "]")
+        escaped = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", escaped)
+        out.append(escaped)
+    rendered = "".join(out)
+
+    def restore(match: re.Match[str]) -> str:
+        label, url = links[int(match.group(1))]
+        return (
+            f'<a href="{html.escape(with_hub_utm(url))}" target="_blank" rel="noopener">'
+            f"{html.escape(label)}</a>"
+        )
+
+    return re.sub(r"\u0002(\d+)\u0002", restore, rendered)
+
+
+def markdown_to_html(src: str) -> str:
+    lines = src.strip().splitlines()
+    out: list[str] = []
+    i = 0
+
+    def is_special(line: str) -> bool:
+        s = line.lstrip()
+        return (
+            not s
+            or s.startswith("<callout")
+            or s.startswith("#")
+            or s.startswith("|")
+            or s.startswith("- ")
+            or s == "---"
+            or bool(re.match(r"\d+\. ", s))
+        )
+
+    while i < len(lines):
+        line = lines[i]
+        stripped = line.strip()
+        if not stripped:
+            i += 1
+            continue
+        if stripped.startswith("<callout"):
+            icon = "💡"
+            match = re.search(r'icon="([^"]+)"', stripped)
+            if match:
+                icon = match.group(1)
+            body: list[str] = []
+            i += 1
+            while i < len(lines) and lines[i].strip() != "</callout>":
+                body.append(lines[i])
+                i += 1
+            i += 1
+            inner = "".join(f"<p>{inline(part.strip())}</p>" for part in body if part.strip())
+            out.append(
+                f'<div class="post-callout"><span class="ico">{html.escape(icon)}</span><div>{inner}</div></div>'
+            )
+            continue
+        if stripped == "---":
+            out.append("<hr>")
+            i += 1
+            continue
+        if stripped.startswith("#"):
+            level = len(stripped) - len(stripped.lstrip("#"))
+            tag = {1: "h2", 2: "h3", 3: "h4"}.get(level, "h4")
+            out.append(f"<{tag}>{inline(stripped[level:].strip())}</{tag}>")
+            i += 1
+            continue
+        if stripped.startswith("|"):
+            rows = []
+            while i < len(lines) and lines[i].strip().startswith("|"):
+                rows.append(lines[i].strip())
+                i += 1
+            parsed = []
+            for row in rows:
+                if re.match(r"^\|\s*-+", row):
+                    continue
+                cells = [inline(cell.strip()) for cell in row.strip("|").split("|")]
+                parsed.append(cells)
+            if parsed:
+                head = "<tr>" + "".join(f"<th>{cell}</th>" for cell in parsed[0]) + "</tr>"
+                body = "".join(
+                    "<tr>" + "".join(f"<td>{cell}</td>" for cell in row) + "</tr>" for row in parsed[1:]
+                )
+                out.append(f"<table><thead>{head}</thead><tbody>{body}</tbody></table>")
+            continue
+        if stripped.startswith("- [") or stripped.startswith("- "):
+            items = []
+            while i < len(lines) and lines[i].strip().startswith("- "):
+                item = lines[i].strip()[2:]
+                if item.startswith("[ ] "):
+                    items.append(
+                        f'<p class="post-todo"><input type="checkbox" disabled> {inline(item[4:])}</p>'
+                    )
+                elif item.startswith("[x] ") or item.startswith("[X] "):
+                    items.append(
+                        f'<p class="post-todo"><input type="checkbox" disabled checked> {inline(item[4:])}</p>'
+                    )
+                else:
+                    items.append(f"<li>{inline(item)}</li>")
+                i += 1
+            if items and items[0].startswith("<li>"):
+                out.append("<ul>" + "".join(items) + "</ul>")
+            else:
+                out.extend(items)
+            continue
+        if re.match(r"\d+\. ", stripped):
+            items = []
+            while i < len(lines) and re.match(r"\d+\. ", lines[i].strip()):
+                item = re.sub(r"^\d+\. ", "", lines[i].strip())
+                items.append(f"<li>{inline(item)}</li>")
+                i += 1
+            out.append("<ol>" + "".join(items) + "</ol>")
+            continue
+        paragraph = [stripped]
+        i += 1
+        while i < len(lines) and lines[i].strip() and not is_special(lines[i]):
+            paragraph.append(lines[i].strip())
+            i += 1
+        out.append(f"<p>{inline(' '.join(paragraph))}</p>")
+    return "".join(out)
+
+
+def parse_source(path: Path) -> dict:
+    raw = path.read_text(encoding="utf-8")
+    if not raw.startswith("---\n"):
+        raise SystemExit(f"front matter 없음: {path.name}")
+    _, meta, body = raw.split("---\n", 2)
+    fields = {}
+    for line in meta.splitlines():
+        key, value = line.split(": ", 1)
+        fields[key] = value
+    category = fields["category"]
+    style = CATEGORY_META.get(category, {"emoji": "📝", "color": "#0B3D91"})
+    external = fields.get("external_url") or None
+    if external in ("", "NONE"):
+        external = None
+    return {
+        "id": fields["id"],
+        "title": fields["title"],
+        "summary": fields["summary"],
+        "category": category,
+        "emoji": style["emoji"],
+        "color": style["color"],
+        "date": fields["date"],
+        "external_url": external,
+        "notion_url": fields["notion_url"],
+        "html": markdown_to_html(body),
+    }
+
+
+def main() -> None:
+    current = json.loads(OUT.read_text(encoding="utf-8"))
+    by_id = {post["id"]: post for post in current["posts"]}
+    added = 0
+    for path in sorted(SRC.glob("*.md")):
+        post = parse_source(path)
+        if not post["html"].strip():
+            raise SystemExit(f"본문이 비었습니다: {path.name}")
+        if post["id"] not in by_id:
+            added += 1
+        by_id[post["id"]] = post
+    posts = sorted(by_id.values(), key=lambda post: post["date"], reverse=True)
+    result = {
+        "generated_at": datetime.now(KST).strftime("%Y-%m-%d %H:%M KST"),
+        "source": "notion",
+        "count": len(posts),
+        "posts": posts,
+    }
+    OUT.write_text(json.dumps(result, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    print(f"posts {len(posts)} (새로 반영 {added})")
+
+
+if __name__ == "__main__":
+    main()
